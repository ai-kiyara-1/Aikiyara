rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function own(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/{document=**} { allow read: if own(uid); allow write: if false; }
    match /publicShares/{id} { allow read, write: if false; }
  }
}
